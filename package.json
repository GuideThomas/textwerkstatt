{
  "name": "translationtool",
  "version": "0.1.0",
  "private": true,
  "license": "EUPL-1.2",
  "description": "SmartDoc AI-Translator — Layout-treue Dokumentenübersetzung",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:client": "cd client && npx vite --port 5173",
    "build": "npm run build:client && npm run build:server",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "cd client && npx vite build",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "backfill:file-sizes": "tsx src/db/backfill-file-sizes.ts",
    "backfill:normalized-hash": "tsx src/db/backfill-normalized-hash.ts",
    "lint": "eslint src/ --ext .ts,.tsx"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/exceljs": "^0.5.3",
    "@types/nodemailer": "^8.0.0",
    "adm-zip": "^0.6.0",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "deepl-node": "^1.26.0",
    "dejavu-fonts-ttf": "^2.37.3",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "fast-xml-parser": "^4.5.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.2.1",
    "openai": "^6.34.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.1",
    "pg-boss": "^10.1.5",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.2",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "shell-quote": "^1.8.4",
    "uuid": "$uuid",
    "brace-expansion": "^5.0.8",
    "adm-zip": "$adm-zip"
  }
}
