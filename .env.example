# === Database ===
DB_HOST=localhost
DB_PORT=5434
DB_NAME=textwerkstatt
DB_USER=textwerkstatt
DB_PASSWORD=YOUR_DB_PASSWORD_HERE

# === Server ===
PORT=3006
# Adresse, auf der der Server lauscht. Leer = 127.0.0.1 (ein Reverse Proxy macht den Weg nach außen).
# Das Dockerfile setzt im Container 0.0.0.0; docker-compose.yml veröffentlicht den Port trotzdem nur auf 127.0.0.1.
BIND_ADDRESS=
NODE_ENV=development
UPLOAD_DIR=./uploads
# Max file size in MB
MAX_FILE_SIZE_MB=100

# === DeepL API (Phase 3) ===
DEEPL_API_KEY=YOUR_DEEPL_KEY_HERE
# Max segments per DeepL batch request (API limit: 50)
DEEPL_BATCH_SIZE=50
# DeepL Zeichenlimit (0 = kein Limit/Pro unlimited, z.B. 500000 fuer Free Plan)
# Bei Erreichen stoppt die App Uebersetzungen bis Admin zuruecksetzt
DEEPL_CHARACTER_LIMIT=0

# === LLM via LiteLLM Proxy (Phase 4: Smart Condensing) ===
LLM_BASE_URL=http://localhost:4000/v1
LLM_API_KEY=YOUR_LITELLM_KEY_HERE
LLM_PRIMARY_MODEL=deepseek/deepseek-chat
LLM_FALLBACK_MODEL=gemini/gemini-2.5-flash
LLM_TEMPERATURE=0
LLM_TIMEOUT_MS=30000
# Condensing Threshold: 1.15 = ab 115% der Quelllaenge
CONDENSING_THRESHOLD=1.15

# === Textwerkstatt: KI-Wege (Plan PLAN-textwerkstatt.md, Phase 2) ===
# Welche Variable ein Weg liest, steht in der Tabelle ki_wege (Verwaltung „KI-Anbindung“), nicht hier.
# Namen sind auf KI_WEG_<NAME>_KEY und LLM_BASE_URL bzw. KI_WEG_<NAME>_URL begrenzt. Leer = Weg geschlossen (HTTP 503).
# Je Weg ein eigener Schlüssel: Das Budget sperrt dann je Weg, und die Positivliste des Schlüssels belegt, welche Modelle
# der Weg erreicht. Die Textwerkstatt weicht nie auf ein anderes Modell aus.
KI_WEG_LOKAL_KEY=
KI_WEG_CLOUD_KEY=

# === Docling PDF Service (Phase 8) ===
DOCLING_URL=http://localhost:5001
DOCLING_TIMEOUT_MS=120000

# === Internal Service Auth ===
# Shared Secret fuer interne Service-to-Service Calls (z.B. Artikelanlage-Assistent → /api/batch-translate)
# Leer lassen = keine Auth (vertraut Localhost-Netzwerk). Beide Services muessen denselben Wert tragen.
TRANSLATION_SERVICE_KEY=

# ÜBERGANG: gemeinsamer Schlüssel für das Illustrator-Panel (/api/cep/*). Seit
# 28.10.2026 meldet sich das Panel mit dem eigenen Microsoft-Konto an und trägt
# einen persönlichen Schlüssel (PLAN-panel-anmeldung.md). Dieser Wert gilt nur noch,
# bis die Zählung in cep_shared_key_uses 14 Tage keinen Aufruf mehr zeigt — dann
# leeren. Leer = gemeinsamer Schlüssel aus (NICHT mehr „offen“). TRANSLATION_SERVICE_KEY
# öffnet /api/cep nicht.
CEP_SERVICE_KEY=

# === Chat-Zugang (Open WebUI auf einem eigenen KI-Server) ===
# Schluessel fuer /api/quick-translate + /api/terminology aus dem Mitarbeiter-Chat.
# ⚠️ ANDERS als die beiden Keys oben: LEER = GESCHLOSSEN (HTTP 503), nicht offen.
#    Dieser Pfad gibt DeepL-Uebersetzungen an einen Aufrufer ausserhalb des Hauses
#    frei und kostet Geld — ein vergessener Schluessel darf nicht in einen offenen
#    Endpunkt umschlagen.
# Erzeugen: openssl rand -hex 32
# Derselbe Wert gehoert in die Valve des Open-WebUI-Werkzeugs, das die Uebersetzung aufruft.
CHAT_SERVICE_KEY=
# Bremsen gegen einen abhanden gekommenen Schluessel (In-Memory, Reset bei Neustart —
# die belastbare Zahl liefert GET /api/glossaries/deepl-usage).
CHAT_MAX_REQUESTS_PER_MINUTE=30
CHAT_MAX_CHARS_PER_DAY=200000

# === Auth (Phase 9) ===
# Microsoft SSO (Azure AD) — shared Azure App with Compliance-Check
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
SESSION_SECRET=YOUR_SESSION_SECRET_HERE
# Sitzungs-Cookie nur über https: auto (nach der Verbindung), true, false. Leer = in Produktion immer (hinter TLS-Proxy richtig).
SESSION_COOKIE_SECURE=

# === Installation ===
# Oeffentliche Adresse (Links in Mails, Illustrator-Panel). Ohne Angabe http://localhost:<PORT>.
APP_URL=
# Name der Organisation: Spalte „Standard (<Name>)“ im Glossar, Absender der Mails. Leer = neutral.
ORGANISATION_NAME=
# Name des Werkzeugs im Browser-Tab. Vorgabe: Textwerkstatt.
APP_NAME=
# Eigene Marken- und Produktnamen, die LanguageTool und das LLM nicht umschreiben duerfen (Komma-Liste).
GESCHUETZTE_WOERTER=
# Absender der Mails (Postfix auf 127.0.0.1:25). Leer = kein Mailversand.
MAIL_FROM=
# LanguageTool-API, z. B. http://localhost:8010 (docker-compose). Leer = Pruefen ist aus.
LANGUAGETOOL_URL=
# Eigene Shop-Hosts fuer Magento-Store-View-Links, z. B. example.com,www.example.com. Leer = absolute Links bleiben.
STOREVIEW_INTERNAL_HOSTS=

# === Glossar-Freigabe und Demo ===
# Wer schreibt direkt ins Glossar: admin (Vorgabe, auch leer oder unbekannt) — alle anderen schlagen nur vor;
# alle — jede angemeldete Person, Löschen aber nur eigener Einträge.
GLOSSAR_FREIGABE=
# Demo-Modus: an = Tor mit gemeinsamem Passwort statt Anmeldung, nur freigegebene API-Wege, Zeichengrenzen je Tag und Sitzung.
# an ohne DEMO_PASSWORT oder mit CHAT_SERVICE_KEY verweigert den Start. Leer oder aus = keine Demo.
DEMO_MODUS=
DEMO_PASSWORT=
# Grenzen der Demo (Vorgaben in Klammern)
# DEMO_DEEPL_ZEICHEN_TAG=20000
# DEMO_DEEPL_ZEICHEN_JE_SITZUNG=5000
# DEMO_KI_ZEICHEN_TAG=100000
# DEMO_KI_ZEICHEN_JE_SITZUNG=20000
# DEMO_MAX_UPLOAD_MB=5
# DEMO_AUFRUFE_JE_MINUTE=120
# DEMO_TOR_VERSUCHE_JE_STUNDE=10

# === Docker ===
# Port auf diesem Rechner (docker-compose.yml veröffentlicht nur auf 127.0.0.1). Vorgabe 3006.
# APP_PORT=3006
# Füllung, die der Container beim Start einspielt (Ordner unter seeds/, wiederholbar). Leer = keine. Vorgabe im Dockerfile: demo
# SEED=demo
